Grammar

    0 $accept: program $end

    1 program: statement_list

    2 statement_list: statement
    3               | statement_list statement

    4 statement: declaration ';'
    5          | collection_definition
    6          | function_definition
    7          | assignment ';'
    8          | expression ';'
    9          | if_statement
   10          | loop_statement
   11          | case_statement
   12          | BREAK ';'
   13          | CONTINUE ';'
   14          | RET expression ';'
   15          | RET ';'
   16          | block
   17          | ';'

   18 declaration: VAR_DECL
   19            | CONST_DECL
   20            | ARRAY_DECL
   21            | VAR_DECL ASSIGN expression
   22            | CONST_DECL ASSIGN expression
   23            | ARRAY_DECL ASSIGN '[' array_values ']'

   24 $@1: /* empty */

   25 collection_definition: COL IDENTIFIER $@1 '{' member_list '}' ';'

   26 member_list: member
   27            | member_list ',' member

   28 member: VAR_DECL
   29       | ARRAY_DECL

   30 $@2: /* empty */

   31 $@3: /* empty */

   32 function_definition: SHAP IDENTIFIER $@2 '(' parameter_list ')' $@3 '>' type block

   33 parameter_list: /* empty */
   34               | parameter
   35               | parameter_list ',' parameter

   36 parameter: VAR_DECL
   37          | ARRAY_DECL
   38          | CONST_DECL ASSIGN expression
   39          | CONST_DECL ASSIGN '[' array_values ']'
   40          | CONST_DECL error

   41 $@4: /* empty */

   42 block: '{' $@4 statement_list '}'
   43      | '{' '}'

   44 assignment: IDENTIFIER ASSIGN expression
   45           | IDENTIFIER '[' expression ']' ASSIGN expression
   46           | IDENTIFIER '.' IDENTIFIER ASSIGN expression
   47           | IDENTIFIER '.' IDENTIFIER ASSIGN '[' array_values ']'
   48           | IDENTIFIER ASSIGN collection_init
   49           | IDENTIFIER ASSIGN '[' array_values ']'

   50 collection_init: '{' member_assignments '}'

   51 member_assignments: member_assignment
   52                   | member_assignments ',' member_assignment

   53 member_assignment: IDENTIFIER ASSIGN expression
   54                  | IDENTIFIER ASSIGN '[' array_values ']'

   55 array_values: expression
   56             | array_values ',' expression

   57 $@5: /* empty */

   58 if_statement: IF '[' expression ']' $@5 block

   59 $@6: /* empty */

   60 if_statement: if_statement ELIF '[' expression ']' $@6 block

   61 $@7: /* empty */

   62 if_statement: if_statement ELSE $@7 block

   63 $@8: /* empty */

   64 loop_statement: LOOP_TILL '[' expression ']' $@8 block

   65 $@9: /* empty */

   66 loop_statement: LOOP VAR_DECL FOR range_expression $@9 block

   67 $@10: /* empty */

   68 loop_statement: LOOP IDENTIFIER FOR range_expression $@10 block

   69 range_expression: '[' expression RANGE expression ']'
   70                 | '[' expression RANGE expression RANGE expression ']'

   71 $@11: /* empty */

   72 case_statement: CASE '[' expression ']' $@11 '{' case_list '}'

   73 case_list: case_item
   74          | case_list case_item

   75 $@12: /* empty */

   76 case_item: '[' case_value ']' $@12 block

   77 $@13: /* empty */

   78 case_item: '[' ']' $@13 block

   79 case_value: INTEGER
   80           | FLOAT
   81           | STRING
   82           | IDENTIFIER

   83 expression: INTEGER
   84           | FLOAT
   85           | STRING
   86           | array_expression
   87           | collection_expression
   88           | function_expression
   89           | '(' expression ')'
   90           | expression '+' expression
   91           | expression '-' expression
   92           | expression '*' expression
   93           | expression '/' expression
   94           | expression '%' expression
   95           | expression '&' expression
   96           | expression '|' expression
   97           | expression '^' expression
   98           | '~' expression
   99           | expression EQ expression
  100           | expression LT expression
  101           | expression GT expression
  102           | expression LE expression
  103           | expression GE expression
  104           | expression AND expression
  105           | expression OR expression
  106           | NOT expression
  107           | '-' expression
  108           | IDENTIFIER

  109 array_expression: IDENTIFIER '[' expression ']'
  110                 | collection_expression '[' expression ']'

  111 collection_expression: IDENTIFIER '.' IDENTIFIER

  112 function_expression: IDENTIFIER '(' argument_list ')'

  113 argument_list: /* empty */
  114              | expression
  115              | argument_list ',' expression

  116 type: TYPE_VOID
  117     | TYPE_INT
  118     | TYPE_FLOAT
  119     | TYPE_STRING
  120     | TYPE_BOOL
  121     | IDENTIFIER



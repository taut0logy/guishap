Grammar

    0 $accept: program $end

    1 program: statement_list

    2 statement_list: statement
    3               | statement_list statement

    4 statement: declaration ';'
    5          | collection_definition
    6          | function_definition
    7          | assignment ';'
    8          | expression ';'
    9          | if_statement
   10          | loop_statement
   11          | case_statement
   12          | BREAK ';'
   13          | CONTINUE ';'
   14          | RET expression ';'
   15          | block
   16          | ';'

   17 declaration: VAR_DECL
   18            | CONST_DECL
   19            | ARRAY_DECL
   20            | VAR_DECL ASSIGN expression
   21            | CONST_DECL ASSIGN expression
   22            | ARRAY_DECL ASSIGN expression

   23 $@1: /* empty */

   24 collection_definition: COL IDENTIFIER $@1 '{' member_list '}' ';'

   25 member_list: member
   26            | member_list ',' member

   27 member: VAR_DECL
   28       | ARRAY_DECL

   29 $@2: /* empty */

   30 function_definition: SHAP IDENTIFIER $@2 '(' parameter_list ')' '>' type block

   31 parameter_list: /* empty */
   32               | parameter
   33               | parameter_list ',' parameter

   34 parameter: VAR_DECL
   35          | ARRAY_DECL
   36          | CONST_DECL ASSIGN expression

   37 $@3: /* empty */

   38 block: '{' $@3 statement_list '}'
   39      | '{' '}'

   40 assignment: IDENTIFIER ASSIGN expression
   41           | IDENTIFIER '[' expression ']' ASSIGN expression
   42           | IDENTIFIER '.' IDENTIFIER ASSIGN expression

   43 $@4: /* empty */

   44 if_statement: IF '[' expression ']' $@4 block

   45 $@5: /* empty */

   46 if_statement: if_statement ELIF '[' expression ']' $@5 block

   47 $@6: /* empty */

   48 if_statement: if_statement ELSE $@6 block

   49 $@7: /* empty */

   50 loop_statement: LOOP_TILL '[' expression ']' $@7 block

   51 $@8: /* empty */

   52 loop_statement: LOOP VAR_DECL FOR range_expression $@8 block

   53 range_expression: '[' expression RANGE expression ']'
   54                 | '[' expression RANGE expression RANGE expression ']'

   55 case_statement: CASE '[' expression ']' '{' case_list '}'

   56 case_list: case_item
   57          | case_list case_item

   58 $@9: /* empty */

   59 case_item: '[' expression ']' ':' $@9 statement

   60 $@10: /* empty */

   61 case_item: '[' ']' ':' $@10 statement

   62 expression: INTEGER
   63           | FLOAT
   64           | STRING
   65           | IDENTIFIER
   66           | IDENTIFIER '[' expression ']'
   67           | IDENTIFIER '.' IDENTIFIER
   68           | IDENTIFIER '(' argument_list ')'
   69           | '(' expression ')'
   70           | expression '+' expression
   71           | expression '-' expression
   72           | expression '*' expression
   73           | expression '/' expression
   74           | expression '%' expression
   75           | expression '&' expression
   76           | expression '|' expression
   77           | expression '^' expression
   78           | '~' expression
   79           | expression EQ expression
   80           | expression LT expression
   81           | expression GT expression
   82           | expression LE expression
   83           | expression GE expression
   84           | expression AND expression
   85           | expression OR expression
   86           | NOT expression
   87           | '-' expression

   88 argument_list: /* empty */
   89              | expression
   90              | argument_list ',' expression

   91 type: TYPE_VOID
   92     | TYPE_INT
   93     | TYPE_FLOAT
   94     | TYPE_STRING
   95     | TYPE_BOOL
   96     | IDENTIFIER



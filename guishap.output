Grammar

    0 $accept: program $end

    1 program: statement_list

    2 statement_list: statement
    3               | statement_list statement

    4 statement: declaration ';'
    5          | collection_definition
    6          | function_definition
    7          | assignment ';'
    8          | expression ';'
    9          | if_statement
   10          | loop_statement
   11          | case_statement
   12          | BREAK ';'
   13          | CONTINUE ';'
   14          | RET expression ';'
   15          | block
   16          | ';'

   17 declaration: VAR_DECL
   18            | CONST_DECL
   19            | ARRAY_DECL
   20            | VAR_DECL ASSIGN expression
   21            | CONST_DECL ASSIGN expression
   22            | ARRAY_DECL ASSIGN '[' array_values ']'

   23 $@1: /* empty */

   24 collection_definition: COL IDENTIFIER $@1 '{' member_list '}' ';'

   25 member_list: member
   26            | member_list ',' member

   27 member: VAR_DECL
   28       | ARRAY_DECL

   29 $@2: /* empty */

   30 $@3: /* empty */

   31 function_definition: SHAP IDENTIFIER $@2 '(' parameter_list ')' $@3 '>' type block

   32 parameter_list: /* empty */
   33               | parameter
   34               | parameter_list ',' parameter

   35 parameter: VAR_DECL
   36          | ARRAY_DECL
   37          | CONST_DECL ASSIGN expression
   38          | CONST_DECL ASSIGN '[' array_values ']'
   39          | CONST_DECL error

   40 $@4: /* empty */

   41 block: '{' $@4 statement_list '}'
   42      | '{' '}'

   43 assignment: IDENTIFIER ASSIGN expression
   44           | IDENTIFIER '[' expression ']' ASSIGN expression
   45           | IDENTIFIER '.' IDENTIFIER ASSIGN expression
   46           | IDENTIFIER '.' IDENTIFIER ASSIGN '[' array_values ']'
   47           | IDENTIFIER ASSIGN collection_init
   48           | IDENTIFIER ASSIGN '[' array_values ']'

   49 collection_init: '{' member_assignments '}'

   50 member_assignments: member_assignment
   51                   | member_assignments ',' member_assignment

   52 member_assignment: IDENTIFIER ASSIGN expression
   53                  | IDENTIFIER ASSIGN '[' array_values ']'

   54 array_values: expression
   55             | array_values ',' expression

   56 $@5: /* empty */

   57 if_statement: IF '[' expression ']' $@5 block

   58 $@6: /* empty */

   59 if_statement: if_statement ELIF '[' expression ']' $@6 block

   60 $@7: /* empty */

   61 if_statement: if_statement ELSE $@7 block

   62 $@8: /* empty */

   63 loop_statement: LOOP_TILL '[' expression ']' $@8 block

   64 $@9: /* empty */

   65 loop_statement: LOOP VAR_DECL FOR range_expression $@9 block

   66 $@10: /* empty */

   67 loop_statement: LOOP IDENTIFIER FOR range_expression $@10 block

   68 range_expression: '[' expression RANGE expression ']'
   69                 | '[' expression RANGE expression RANGE expression ']'

   70 $@11: /* empty */

   71 case_statement: CASE '[' expression ']' $@11 '{' case_list '}'

   72 case_list: case_item
   73          | case_list case_item

   74 $@12: /* empty */

   75 case_item: '[' case_value ']' $@12 block

   76 $@13: /* empty */

   77 case_item: '[' ']' $@13 block

   78 case_value: INTEGER
   79           | FLOAT
   80           | STRING
   81           | IDENTIFIER

   82 expression: INTEGER
   83           | FLOAT
   84           | STRING
   85           | array_expression
   86           | collection_expression
   87           | function_expression
   88           | '(' expression ')'
   89           | expression '+' expression
   90           | expression '-' expression
   91           | expression '*' expression
   92           | expression '/' expression
   93           | expression '%' expression
   94           | expression '&' expression
   95           | expression '|' expression
   96           | expression '^' expression
   97           | '~' expression
   98           | expression EQ expression
   99           | expression LT expression
  100           | expression GT expression
  101           | expression LE expression
  102           | expression GE expression
  103           | expression AND expression
  104           | expression OR expression
  105           | NOT expression
  106           | '-' expression
  107           | IDENTIFIER

  108 array_expression: IDENTIFIER '[' expression ']'
  109                 | collection_expression '[' expression ']'

  110 collection_expression: IDENTIFIER '.' IDENTIFIER

  111 function_expression: IDENTIFIER '(' argument_list ')'

  112 argument_list: /* empty */
  113              | expression
  114              | argument_list ',' expression

  115 type: TYPE_VOID
  116     | TYPE_INT
  117     | TYPE_FLOAT
  118     | TYPE_STRING
  119     | TYPE_BOOL
  120     | IDENTIFIER



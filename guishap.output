state 0

    0 $accept: . program $end

    IDENTIFIER  shift, and go to state 1
    STRING      shift, and go to state 2
    INTEGER     shift, and go to state 3
    FLOAT       shift, and go to state 4
    COL         shift, and go to state 5
    SHAP        shift, and go to state 6
    RET         shift, and go to state 7
    LOOP_TILL   shift, and go to state 8
    LOOP        shift, and go to state 9
    BREAK       shift, and go to state 10
    CONTINUE    shift, and go to state 11
    IF          shift, and go to state 12
    CASE        shift, and go to state 13
    VAR_DECL    shift, and go to state 14
    CONST_DECL  shift, and go to state 15
    ARRAY_DECL  shift, and go to state 16
    NOT         shift, and go to state 17
    '-'         shift, and go to state 18
    '~'         shift, and go to state 19
    ';'         shift, and go to state 20
    '{'         shift, and go to state 21
    '('         shift, and go to state 22

    program                go to state 23
    statement_list         go to state 24
    statement              go to state 25
    declaration            go to state 26
    collection_definition  go to state 27
    function_definition    go to state 28
    block                  go to state 29
    assignment             go to state 30
    if_statement           go to state 31
    loop_statement         go to state 32
    case_statement         go to state 33
    expression             go to state 34


state 1

   40 assignment: IDENTIFIER . ASSIGN expression
   41           | IDENTIFIER . '[' expression ']' ASSIGN expression
   42           | IDENTIFIER . '.' IDENTIFIER ASSIGN expression
   65 expression: IDENTIFIER .
   66           | IDENTIFIER . '[' expression ']'
   67           | IDENTIFIER . '.' IDENTIFIER
   68           | IDENTIFIER . '(' argument_list ')'

    ASSIGN  shift, and go to state 35
    '('     shift, and go to state 36
    '['     shift, and go to state 37
    '.'     shift, and go to state 38

    $default  reduce using rule 65 (expression)



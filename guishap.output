  107 expression: IDENTIFIER .
  108 array_expression: IDENTIFIER . '[' expression ']'
  110 collection_expression: IDENTIFIER . '.' IDENTIFIER
  111 function_expression: IDENTIFIER . '(' argument_list ')'

